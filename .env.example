# Port the server listens on
PORT=3000

# Public origin used when building short links (no trailing slash).
# If unset, the origin of each incoming request is used.
# BASE_URL=https://sho.rt

# Location of the SQLite database file
# DATABASE_PATH=./data/urls.db

# Set when running behind a reverse proxy (e.g. "1") so the request
# protocol is read from X-Forwarded-Proto.
# TRUST_PROXY=1
