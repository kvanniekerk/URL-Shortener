<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'URL Shortener' }) %>
    <script src="/main.js" defer></script>
</head>
<body>
<% const blank = { code: '', shortUrl: '', originalUrl: '', visits: 0 }; %>
<div class="page">
    <%- include('partials/brand') %>

    <main>
        <section class="intro">
            <h1>Make long links <span class="accent">short</span>.</h1>
            <p>Paste a link and get a short URL you can share. Built on a small REST API with Node.js, Express and SQLite.</p>
        </section>

        <section class="card" aria-labelledby="shorten-heading">
            <h2 id="shorten-heading">Shorten a link</h2>
            <form id="shorten-form" class="field-row" method="post" action="/">
                <label class="visually-hidden" for="url">Long URL</label>
                <input id="url" name="url" type="url" required autocomplete="off" spellcheck="false"
                       placeholder="https://example.com/a/very/long/link"
                       value="<%= shorten.value || '' %>">
                <button type="submit" class="btn btn-primary">Shorten</button>
            </form>
            <div id="shorten-status" class="status" role="status" aria-live="polite">
                <% if (shorten.error) { %><p class="alert"><%= shorten.error %></p><% } %>
                <% if (shorten.result) { %><%- include('partials/result', { link: shorten.result, label: 'Your short link' }) %><% } %>
            </div>
        </section>

        <section class="card" aria-labelledby="lookup-heading">
            <h2 id="lookup-heading">Look up a short link</h2>
            <form id="lookup-form" class="field-row" method="get" action="/">
                <label class="visually-hidden" for="lookup">Short URL or code</label>
                <input id="lookup" name="lookup" type="text" required autocomplete="off" spellcheck="false"
                       placeholder="Short URL or 7-character code"
                       value="<%= lookup.value || '' %>">
                <button type="submit" class="btn btn-secondary">Look up</button>
            </form>
            <div id="lookup-status" class="status" role="status" aria-live="polite">
                <% if (lookup.error) { %><p class="alert"><%= lookup.error %></p><% } %>
                <% if (lookup.result) { %><%- include('partials/result', { link: lookup.result, label: 'Found it' }) %><% } %>
            </div>
        </section>

        <section class="card" aria-labelledby="recent-heading">
            <div class="card-head">
                <h2 id="recent-heading">Recent links</h2>
                <span class="pill" id="link-count"><%= links.length %></span>
            </div>
            <p class="empty" id="empty-state" <%= links.length ? 'hidden' : '' %>>
                No links yet. Shorten one above and it will show up here.
            </p>
            <div class="table-wrap" id="links-table" <%= links.length ? '' : 'hidden' %>>
                <table class="links">
                    <thead>
                        <tr>
                            <th scope="col">Short link</th>
                            <th scope="col">Original URL</th>
                            <th scope="col" class="num">Clicks</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody id="links-body">
                        <% links.forEach((link) => { %><%- include('partials/link-row', { link }) %><% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        Built by Kyle van Niekerk · Node.js · Express · SQLite
    </footer>
</div>

<template id="result-template"><%- include('partials/result', { link: blank, label: '' }) %></template>
<template id="row-template"><%- include('partials/link-row', { link: blank }) %></template>
</body>
</html>
